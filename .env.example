# Copier ce fichier en ".env" (valeurs locales, non versionne) puis adapter.
#
# Rappel : en developpement, ".env.development" fournit deja
#   VITE_API_BASE_URL=/api            (proxy Vite, aucun CORS)
#   API_PROXY_TARGET=http://localhost:3003
# Ce fichier n'est donc utile que pour pointer vers un autre backend, ou pour le
# build de production (npm run build).

# URL du backend utilisee par le build de production.
VITE_API_BASE_URL=http://localhost:3003/api

# Cible du proxy Vite en developpement (jamais exposee au navigateur).
API_PROXY_TARGET=http://localhost:3003
