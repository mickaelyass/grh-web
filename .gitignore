# dependencies
/node_modules
yarn.lock
# package-lock.json DOIT etre versionne : Render (npm ci) et GitHub Actions
# en dependent pour des installs reproductibles.

# testing
/coverage

# production
/build

# misc
.eslintcache
.DS_Store
.idea
.env
.env.*
!.env.example
# ".env.development" ne contient aucune donnee sensible (proxy Vite) et doit etre
# versionne pour que "npm start" fonctionne sans configuration sur toutes les machines.
!.env.development
/dist
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# vite build artifacts
vite.config.mjs.timestamp-*.mjs
